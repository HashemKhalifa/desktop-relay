{
  "name": "desktop-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted authenticated relay exposing desktop-commander MCP over HTTPS",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@wonderwhy-er/desktop-commander": "0.2.51"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0"
  },
  "scripts": {
    "build:viewer": "esbuild src/file-viewer-client.js --bundle --format=iife --target=es2022 --minify --legal-comments=eof --outfile=src/file-viewer.bundle.js",
    "daemon": "node src/daemon.ts",
    "ctl": "node src/ctl.ts",
    "verify": "scripts/verify.sh",
    "test": "node --test test/*.test.ts",
    "check:shell": "for file in install.sh uninstall.sh bin/dc-relayctl scripts/*.sh; do bash -n \"$file\" || exit; done",
    "check": "pnpm test && pnpm run check:shell",
    "verify:context": "node scripts/verify-context.ts"
  },
  "packageManager": "pnpm@10.34.5"
}
