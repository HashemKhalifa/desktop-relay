<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>app.desktop-relay.power</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@LOGDIR@/power.log</string>
  <key>StandardErrorPath</key><string>@LOGDIR@/power.err.log</string>
</dict>
</plist>
