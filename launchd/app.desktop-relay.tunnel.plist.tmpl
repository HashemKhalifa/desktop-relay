<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>app.desktop-relay.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    @TUNNEL_ARGS@
  </array>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>@LOGDIR@/tunnel.log</string>
  <key>StandardErrorPath</key><string>@LOGDIR@/tunnel.err.log</string>
</dict>
</plist>
