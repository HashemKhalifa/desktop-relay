{
  "edge": { "kind": "ngrok", "domain": "<your-static>.ngrok-free.app" },
  "publicBaseUrl": "https://<your-static>.ngrok-free.app",
  "listenHost": "127.0.0.1",
  "listenPort": 8788,
  "upstreamCmd": ["/usr/local/bin/node", "/ABSOLUTE/PATH/desktop-relay/node_modules/@wonderwhy-er/desktop-commander/dist/index.js"],
  "upstreamCwd": "~",
  "secretsPath": "~/.config/desktop-relay/principals.json",
  "auditPath": "~/.config/desktop-relay/audit.jsonl",
  "alertsPath": "~/.config/desktop-relay/alerts.jsonl",
  "controlSockPath": "~/.config/desktop-relay/control.sock",
  "rpcDeadlineMs": 900000,
  "uploadDeadlineMs": 10000,
  "maxBodyBytes": 16777216,
  "maxConcurrentPosts": 32,
  "maxSessions": 64,
  "logDir": "~/Library/Logs/desktop-relay"
}
